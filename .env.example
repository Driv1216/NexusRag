# ==============================================================================
# NexusRAG Environment Configuration
# ==============================================================================

# Required: Google Gemini API Key for vision captioning, query synthesis, and LLM evaluation
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Enable Cross-Encoder model download for neural re-ranking (defaults to false for low-latency weighted RRF)
ENABLE_RERANKER_DOWNLOAD=false

# Optional: Enable CLIP visual embedding model download (defaults to false)
ENABLE_CLIP_DOWNLOAD=false

# Server Host & Port Settings
HOST=0.0.0.0
PORT=8000
